modules = ["python-base-3.13", "ruby-3.2", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "gumbo", "harfbuzz", "jbig2dec", "libjpeg_turbo", "mupdf", "openjpeg", "swig", "xcbuild"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "jekyll build --source . --destination /tmp/garrett-site-preview && python3 -m http.server 5000 --bind 0.0.0.0 --directory /tmp/garrett-site-preview"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
